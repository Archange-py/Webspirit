{
    "manifest_version": 2,
    "name": "Bookmark Capturer",
    "version": "1.0",
    "description": "Capture l'onglet actif et envoie l'URL/titre vers l'app locale.",
    "permissions": [
        "activeTab",
        "tabs",
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "browser_action": {
        "default_title": "Ajouter ce bookmark"
    },
    "commands": {
        "capture": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y"
            },
            "description": "Capturer l'onglet courant"
        }
    }
}